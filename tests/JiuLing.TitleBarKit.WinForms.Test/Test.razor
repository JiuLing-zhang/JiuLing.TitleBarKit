@inject TitleBarService TitleBarService

<div class="custom-title-bar">
    <div class="title-content" @onmousedown="OnMouseDown">
        <span class="title-text">WinForms Blazor Web 组件</span>
    </div>
    <div class="title-buttons">
        <button @onclick="Minimize" class="btn">_</button>
        <button @onclick="ToggleMaximize" class="btn">🗖</button>
        <button @onclick="Close" class="btn">X</button>
    </div>
</div>

<div>
    我是 WinForms Blazor 开发的页面
</div>

<style>
    .custom-title-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        cursor: move;
        background-color: #444444;
        color: white;
    }

    .title-content {
        flex-grow: 1;
    }

    .title-buttons {
        display: flex;
    }
</style>

@code {
    private void Minimize()
    {
        TitleBarService.TitleBar.Minimize();
    }

    private void ToggleMaximize()
    {
        TitleBarService.TitleBar.ToggleMaximize();
    }

    private void Close()
    {
        TitleBarService.TitleBar.Close();
    }

    private void OnMouseDown(MouseEventArgs e)
    {
        TitleBarService.Draggable.DragMove();
    }
}